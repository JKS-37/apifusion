# Copy this file to .env and fill in real values for local/dev use.
# In production (Render/Railway) set these as dashboard environment variables instead.

SECRET_KEY=1234567890
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset to fall back to local sqlite3.
# Example Postgres URL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

SECURE_SSL_REDIRECT=True
